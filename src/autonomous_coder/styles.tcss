/* Autonomous Coder TUI Styles */

Screen {
    layout: vertical;
}

Header {
    background: $primary-darken-2;
}

Footer {
}

#sidebar {
    width: 30;
    height: 100%;
    border-right: solid $primary-darken-1;
}

#agent-tree {
    height: 60%;
    border-bottom: solid $primary-darken-1;
}

#progress {
    height: 40%;
    padding: 1;
}

#main {
    height: 100%;
}

#agent-tabs {
    height: 70%;
}

#details {
    height: 30%;
    border-top: solid $primary-darken-1;
}

#task-detail {
    width: 1fr;
    padding: 1;
    border-right: solid $primary-darken-1;
}

#cost-display {
    width: 30;
    padding: 1;
}

/* Agent tree styling */
AgentTree .tree--label {
    color: $text;
}

AgentTree .tree--cursor {
    background: $primary;
    color: $text;
}

/* Streaming log */
StreamingLog {
    scrollbar-size: 1 1;
}

/* Progress panel */
ProgressPanel ProgressBar {
    margin: 1 0;
}

/* Cost display */
CostDisplay {
    text-align: center;
}

CostDisplay .cost-total {
    text-style: bold;
    color: $success;
}

CostDisplay .cost-warning {
    color: $warning;
}

CostDisplay .cost-danger {
    color: $error;
}

/* Status indicators */
.status-running { color: $primary; }
.status-complete { color: $success; }
.status-error { color: $error; }
.status-pending { color: $text-muted; }
